# Copy to .env and fill in values
# Then: export $(cat .env | xargs)

# Telegram (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (@userinfobot)
TELEGRAM_USER_ID=123456789

# ⚠️  Do NOT set ANTHROPIC_API_KEY here!
# Claude Code uses your Pro/Max subscription via OAuth.
# If ANTHROPIC_API_KEY is set, it'll charge API billing instead.
